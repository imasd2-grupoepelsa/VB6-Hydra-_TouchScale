Public Function baja()
    Dim dbtxt As dao.Database
    Dim rsttxt As dao.Recordset
    Dim sSQL As String
    Dim cnt As Long
    Set dbtxt = OpenDatabase(Base_General)
    sSQL = "SELECT *" & _
           " FROM linTxt2040" & _
           " WHERE codigo=" & CStr(lintxt.codigo) & _
           " AND plu=" & CStr(lintxt.Plu) & _
           " AND mostrador=" & CStr(lintxt.Mostrador) & _
           " ORDER BY codigo"
    Set rsttxt = dbtxt.OpenRecordset(sSQL)
    With rsttxt
        If (Not .EOF) Then
            For cnt = 1 To .Recordcount
                .Delete
            Next cnt
        End If
        .Close
    End With
    Set rsttxt = Nothing
    dbtxt.Close
    Set dbtxt = Nothing
End Function
