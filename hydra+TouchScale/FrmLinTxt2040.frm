Public Function alta()
    Dim dbtxt As dao.Database
    Dim rsttxt As dao.Recordset
    Dim rstArt As dao.Recordset
    Dim sSQL As String
    Dim cnt As Long
    If ((lintxt.abm <> 1) And (lintxt.abm <> 3)) Then Exit Function
    Set dbtxt = OpenDatabase(Base_General)
    '1.0.1
    'sSQL = "SELECT *" & _
    '       " FROM linTxt2040" & _
    '       " WHERE codigo=" & CStr(lintxt.codigo) & _
    '       " AND plu=" & CStr(lintxt.plu) & _
    '       " AND mostrador=" & CStr(lintxt.Mostrador) & _
    '       " ORDER BY codigo"
    sSQL = "SELECT *" & _
           " FROM linTxt2040" & _
           " WHERE codigo=" & CStr(lintxt.codigo) & " ORDER BY codigo"
    
    Set rsttxt = dbtxt.OpenRecordset(sSQL)
    With rsttxt
        If (.EOF) Then
            .AddNew
        Else
            .Edit
        End If
        .Fields(0) = lintxt.codigo
        .Fields(1) = lintxt.Plu
        .Fields(2) = lintxt.Mostrador
        For cnt = 0 To 19
            .Fields(cnt + 3) = lintxt.txt(cnt)
        Next cnt
        .Fields(23) = lintxt.tran_txt2
        .Update
        .Close
    End With
    Set rstArt = Nothing
    sSQL = "SELECT *" & _
           " FROM articulo" & _
           " WHERE codigo=" & CStr(lintxt.codigo) & _
           " ORDER BY codigo"
    Set rstArt = dbtxt.OpenRecordset(sSQL)
    If (Not rstArt.EOF) Then
        rstArt.Edit
        rstArt.Fields("TRAN_TX1") = ""
        rstArt.Update
        rstArt.Close
    End If
    dbtxt.Close
    Set dbtxt = Nothing
End Function
